BasedOnStyle: LLVM

IndentWidth: 8
UseTab: Always
IndentCaseLabels: false

IncludeBlocks: Regroup
IncludeCategories:
  - Regex:           '<SDL3/SDL_main.h>'
    Priority:        -1
  - Regex:           '^<SDL3(_[[:alnum:]]+)?/SDL'
    Priority:        1
  - Regex:           '^<'
    Priority:        2
  - Regex:           '^"'
    Priority:        3